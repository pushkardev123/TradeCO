{
    "name": "trading-platform-monorepo",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev:infra:up": "docker compose up -d postgres redis",
        "dev:infra:down": "docker compose down",
        "dev:infra:logs": "docker compose logs -f postgres redis",
        "infra:up": "docker compose up -d postgres redis",
        "infra:down": "docker compose down",
        "infra:logs": "docker compose logs -f postgres redis",
        "dev:frontend": "npm --workspace apps/frontend run dev",
        "dev:backend": "npm --workspace apps/backend run dev",
        "dev:execution": "npm --workspace apps/execution-service run dev",
        "dev:event": "npm --workspace apps/event-service run dev",
        "smoke:p0-auth-boundary": "node scripts/p0-auth-boundary-smoke.mjs",
        "smoke:p2-market-order": "node scripts/p2-e2e-market-order-smoke.mjs",
        "smoke:p2-redis-stream": "node scripts/p2-redis-stream-smoke.mjs",
        "test:stream-contracts": "npm --workspace @tradeco/redis-stream-contracts run test"
    }
}
