# Copy to .env.deploy before using docker-compose.deploy.yml.
# Keep .env.deploy out of git.

TRADECO_POSTGRES_DB=tradeco
# Keep this under PostgreSQL's 63-byte role-name limit.
TRADECO_POSTGRES_USER=tradeco
TRADECO_POSTGRES_PASSWORD=replace_with_strong_postgres_password
TRADECO_POSTGRES_PORT=5432
TRADECO_REDIS_PORT=6379

# Optional direct service URLs.
# Leave unset for Docker Compose defaults, or set when using managed services,
# PM2, or URL-encoded database credentials. If DATABASE_URL points at the
# bundled `postgres` service, its user/password/database must match the
# TRADECO_POSTGRES_* values above.
# DATABASE_URL=postgresql://tradeco:replace_with_strong_postgres_password@127.0.0.1:5432/tradeco?schema=public
# REDIS_URL=redis://127.0.0.1:6379

FRONTEND_PORT=3000
BACKEND_PORT=8080
EVENT_SERVICE_PORT=8081
PUBLIC_APP_ORIGIN=http://localhost:3000

# Backend and event-service must share JWT_SECRET.
JWT_SECRET=replace-with-at-least-32-character-deploy-secret
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_COOKIE_NAME=tradeco_refresh
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

# Backend and execution-service must share ENCRYPTION_KEY.
# Must be exactly 32 characters.
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

COMMANDS_CHANNEL=commands:order:submit
LEGACY_COMMANDS_CHANNEL_ENABLED=false
ORDER_COMMAND_STREAM=tradeco:orders:commands:v1
ORDER_COMMAND_DLQ_STREAM=tradeco:orders:commands:dlq:v1
ORDER_EVENT_STREAM=tradeco:orders:events:v1
ORDER_COMMAND_CONSUMER_GROUP=tradeco:execution:orders:v1
ORDER_COMMAND_READ_COUNT=10
ORDER_COMMAND_CLAIM_IDLE_MS=30000
ORDER_COMMAND_MAX_ATTEMPTS=5
RECONCILIATION_ENABLED=true
RECONCILIATION_INTERVAL_MS=60000
RECONCILIATION_STALE_MS=30000
RECONCILIATION_BATCH_SIZE=100

EVENTS_CHANNEL=events:order:status
PRICES_CHANNEL=events:price:update
BALANCES_CHANNEL=events:account:balances
CHART_REQ_CHANNEL=events:chart:request
CHARTS_CHANNEL=events:chart:update
ACCOUNT_REQ_CHANNEL=events:account:request
ACCOUNT_RES_CHANNEL=events:account:response
SYMBOL_REQ_CHANNEL=events:symbol:request
SYMBOL_RES_CHANNEL=events:symbol:response
ACCOUNT_CACHE_MS=5000
SYMBOL_CACHE_MS=600000

# Testnet only.
BINANCE_API_BASE=https://testnet.binance.vision
BINANCE_WS_BASE=wss://stream.testnet.binance.vision
BINANCE_WS_API_BASE=wss://ws-api.testnet.binance.vision/ws-api/v3
MARKET_MODE=all
SYMBOLS=btcusdt
DEFAULT_KLINE_INTERVAL=1m

# Local direct-port defaults. For nginx, replace with your public domain mappings.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_EVENT_SERVICE_URL=http://localhost:8081
NEXT_PUBLIC_WS_URL=ws://localhost:8081/prices
NEXT_PUBLIC_MARKET_FLUSH_MS=1500
NEXT_PUBLIC_MAX_SYMBOLS=1000
NEXT_PUBLIC_ENABLE_ADVANCED_ORDERS=true
