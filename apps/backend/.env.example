DATABASE_URL="postgresql://tradeco:tradeco_local_password@localhost:5432/tradeco?schema=public"
REDIS_URL="redis://localhost:6379"

# Use a long local-only value. Backend and event-service must share this.
JWT_SECRET="replace-with-at-least-32-character-dev-secret"
JWT_ACCESS_TTL_SECONDS="900"
REFRESH_TOKEN_TTL_DAYS="30"
REFRESH_COOKIE_NAME="tradeco_refresh"
# Public URL path for the refresh cookie. Behind nginx mapping /api/ -> backend /,
# set this to "/api/auth".
REFRESH_COOKIE_PATH="/auth"
AUTH_COOKIE_SECURE="false"
AUTH_COOKIE_SAME_SITE="lax"

# Must be exactly 32 characters. Backend and execution-service must share this.
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef"

PORT="8080"
CORS_ORIGIN="http://localhost:3000"

# Legacy Pub/Sub command transport. Keep until the Redis Streams runtime migration lands.
COMMANDS_CHANNEL="commands:order:submit"

# Target durable order command streams.
ORDER_COMMAND_STREAM="tradeco:orders:commands:v1"
ORDER_COMMAND_DLQ_STREAM="tradeco:orders:commands:dlq:v1"
ORDER_EVENT_STREAM="tradeco:orders:events:v1"

# Testnet only. Do not point this app at production Binance endpoints.
BINANCE_API_BASE="https://testnet.binance.vision"
