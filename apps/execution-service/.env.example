DATABASE_URL="postgresql://tradeco:tradeco_local_password@localhost:5432/tradeco?schema=public"
REDIS_URL="redis://localhost:6379"

# Must be exactly 32 characters and match backend ENCRYPTION_KEY.
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef"

COMMANDS_CHANNEL="commands:order:submit"
EVENTS_CHANNEL="events:order:status"
PRICES_CHANNEL="events:price:update"
BALANCES_CHANNEL="events:account:balances"
CHART_REQ_CHANNEL="events:chart:request"
CHARTS_CHANNEL="events:chart:update"
DEFAULT_KLINE_INTERVAL="1m"
ACCOUNT_REQ_CHANNEL="events:account:request"
ACCOUNT_RES_CHANNEL="events:account:response"
SYMBOL_REQ_CHANNEL="events:symbol:request"
SYMBOL_RES_CHANNEL="events:symbol:response"
ACCOUNT_CACHE_MS="5000"
SYMBOL_CACHE_MS="600000"

# Testnet only. Do not point this app at production Binance endpoints.
BINANCE_API_BASE="https://testnet.binance.vision"
BINANCE_WS_BASE="wss://stream.testnet.binance.vision"
MARKET_MODE="all"
SYMBOLS="btcusdt"
